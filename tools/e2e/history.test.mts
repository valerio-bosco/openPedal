import { History } from "../../ui/src/history.ts";
const node = (id: string, x: number, params: Record<string, number> = {}) => ({ id, type: "pedal" as const, position: { x, y: 0 }, data: { kind: "drive", params } });
const ok = (c: boolean, m: string) => { if (!c) { console.log("FAIL:", m); process.exit(1); } console.log("ok  ", m); };
const h = new History();
const a = { nodes: [node("in", 0), node("d", 100)], edges: [{ id: "in->d", source: "in", target: "d" }] };
h.reset(a as any);
ok(!h.canUndo, "nothing to undo after reset");
ok(!h.record({ ...a, nodes: a.nodes.map((n) => ({ ...n, selected: true })) } as any), "selection alone is not a step");
const b = { nodes: [node("in", 0), node("d", 100, { gain_db: 20 })], edges: a.edges };
ok(h.record(b as any), "parameter change recorded");
const c = { nodes: [node("in", 0)], edges: [] };
ok(h.record(c as any), "deletion recorded");
let s = h.undo()!; ok(s.nodes.length === 2 && (s.nodes[1].data.params as any).gain_db === 20, "undo restores the deleted pedal");
s = h.undo()!; ok((s.nodes[1].data.params as any).gain_db === undefined, "undo again restores the parameter");
ok(!h.canUndo && h.canRedo, "start of the history");
s = h.redo()!; s = h.redo()!; ok(s.nodes.length === 1, "redo twice returns to the deletion");
h.undo(); ok(h.record({ nodes: [node("in", 50)], edges: [] } as any) && !h.canRedo, "a new change clears redo");
for (let i = 0; i < 150; i++) h.record({ nodes: [node("in", i * 10)], edges: [] } as any);
let n = 0; while (h.undo()) n++; ok(n === 100, `limit of 100 steps (${n})`);
