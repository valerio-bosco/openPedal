              "min": 2500.0,
              "max": 9000.0
            },
            {
              "target": "tone.treble",
              "min": 0.2,
              "max": 0.8
            }
          ]
        },
        {
          "id": "body",
          "label": "Body",
          "kind": "knob",
          "default": 0.5,
          "route": [
            {
              "target": "tone.bass",
              "min": 0.2,
              "max": 0.8
            }
          ]
        },
        {
          "id": "voice",
          "label": "Voice",
          "kind": "selector",
          "default": 0.0,
          "options": [
            "Smooth",
            "Crunch",
            "Fuzz"
          ],
          "route": [
            {
              "target": "drive.shape",
              "values": [
                "soft",
                "asym",
                "fuzz"
              ]
            }
          ]
        },
        {
          "id": "boost",
