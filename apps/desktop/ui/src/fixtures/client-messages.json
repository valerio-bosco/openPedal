        {
          "from": "hp",
          "to": "drive"
        },
        {
          "from": "drive",
          "to": "tone"
        },
        {
          "from": "tone",
          "to": "lp"
        },
        {
          "from": "lp",
          "to": "pedal_out"
        }
      ],
      "control": [
        {
          "id": "grit",
          "label": "Grit",
          "kind": "knob",
          "default": 0.55,
          "route": [
            {
              "target": "drive.gain_db",
              "min": 6.0,
              "max": 40.0
            },
            {
              "target": "drive.level_db",
